# Required on Vercel for cart → Shopify checkout (CartSidebar). Example: your-brand.myshopify.com
VITE_SHOPIFY_STORE=

# Optional: Storefront API for live catalog in lib/shopify.ts (public token only; never Admin token)
# VITE_SHOPIFY_STOREFRONT_TOKEN=

# Optional: used by scripts/sync-to-shopify.ts (local / CI only; never commit real tokens)
SHOPIFY_STORE=
SHOPIFY_ADMIN_TOKEN=

# Optional storefront integrations
VITE_GOOGLE_APPS_SCRIPT_URL=
